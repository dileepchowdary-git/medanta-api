# Copy to .env and fill in. .env is gitignored - never commit it.

# Key the Medanta robot sends in the Authorization header (>= 32 chars).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(40))"
MEDANTA_API_KEY=

# Optional: only these caller IPs may use the API (comma-separated). Empty = any IP with the key.
MEDANTA_ALLOWED_IPS=

# 5C read replica (same values as /root/yashoda/.env)
PG_HOST_PROD=
PG_USER_PROD=
PG_PASSWORD_PROD=
# PG_PORT_PROD=5432

# 5C API key (same value as FIVEC_AUTH in /root/Health-map-Report-sync/.env)
FIVEC_AUTH=
# FIVEC_BASE=https://api.5cnetwork.com

# Optional: Google Chat webhook for paste failures
MEDANTA_GCHAT_WEBHOOK=

# Optional overrides
# MEDANTA_MODALITIES=ALL        (or e.g. CT,MRI)
# MEDANTA_ROBOT_DOWN_MIN=30     (robot-down GChat alert; 0 = off)
# MEDANTA_SUMMARY_AT=21:00      (daily GChat summary, local time; empty = off)
# MEDANTA_DEFAULT_DAYS=2
# MEDANTA_MAX_DAYS=7
# MEDANTA_API_PORT=8003
